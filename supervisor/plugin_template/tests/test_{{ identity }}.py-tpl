"""Behaviour of {{ identity }}, against a temporary project (supervisor.testing is unstable: no compatibility
promise across minor framework versions)."""
from __future__ import annotations

from supervisor import testing

import {{ package }} as plugin


def test_the_job_completes(tmp_path):
    out = plugin.hello(tmp_path, tmp_path, greeting="hi")
    assert out["status"] == "COMPLETE" and out["notes"] == "hi"


def test_the_doctor_check_reads_the_configuration(tmp_path):
    layout = testing.project(tmp_path, plugins=["{{ identity }}"],
                             routing={"plugins": {"{{ identity }}": {"greeting": "hey"}}})
    check = plugin.check(layout)
    assert check.ok and check.name == "{{ identity }}" and "hey" in check.detail
