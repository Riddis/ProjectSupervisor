"""{{ identity }}: a Supervisor extension package.

Import only `supervisor.ext` (the public extension API), and register only inside setup(): importing this package
must change nothing. Everything setup() registers is declared in supervisor-extension.toml."""
from __future__ import annotations

from supervisor import ext


def hello(root, run_dir, **params) -> dict:
    """A python job (`job: {adapter: python, fn: {{ identity }}_hello}`): replace it with real work."""
    return {"status": "COMPLETE", "artifacts": [], "notes": params.get("greeting", "hello")}


def check(layout) -> ext.Check:
    greeting = ext.config(layout, "{{ identity }}")["greeting"]
    return ext.Check("{{ identity }}", True, f"configured (greeting: {greeting})")


def setup(registry) -> None:
    registry.python_job(registry.identity + "_hello", hello)
    registry.doctor_check(check)
